   "source": [
    "import numpy as np\n",
    "from scipy.stats import norm\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.arange(-5,5,0.001)\n",
    "y = norm.pdf(x,0,1)\n",
    "\n",
    "plt.plot(x,y)\n",
    "plt.title(\"Normal Distribution (mean=0, std=1)\")\n",
    "plt.show()"
   ]
  },
